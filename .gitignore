# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local agent / tooling caches
/.midnight-expert/
/.claude/

# lefthook local overrides (per-developer, not committed)
/lefthook-local.yml

# Brainstorming visual companion working files
/.superpowers/

# Docs site build artifacts
site/node_modules
site/build
site/.docusaurus

# Local planning artifacts (specs/plans) — not version controlled
/docs/superpowers/

# macOS cruft
.DS_Store
**/.DS_Store

# Local compose deployment config, copied from rover.toml.example — may
# carry environment-specific [http]/[ssrf] settings, not for commit.
/rover.toml

# Compose secrets (ROVER_HTTP_TOKEN, ANTHROPIC_API_KEY).
/.env
