[4.119825, "o", "             .--~~,__       ____\r\n:-....,-------`~~'._.'     / __ \\____ _   _____  _____\r\n `-,,,  ,_      ;'~U'     / /_/ / __ \\ | / / _ \\/ ___/\r\n  _,-' ,'`-__; '--.      / _, _/ /_/ / |/ /  __/ /\r\n (_/'~~      ''''(;     /_/ |_|\\____/|___/\\___/_/\r\n\r\n\r\nWeb fetch & prep for LLM agents\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1mrover\u001b[0m [OPTIONS] <COMMAND>\r\n\r\n\u001b[1m\u001b[4mCommands:\u001b[0m\r\n  \u001b[1mmcp\u001b[0m     Start the MCP server (long-running)\r\n  \u001b[1mfetch\u001b[0m   One-shot fetch, prints markdown to stdout\r\n  \u001b[1mbatch\u001b[0m   Inspect or monitor a batch_fetch task (alias for `rover task` with a kind check)\r\n  \u001b[1mtask\u001b[0m    Inspect or monitor a long-running task\r\n  \u001b[1mcache\u001b[0m   Cache operations\r\n  \u001b[1mdoctor\u001b[0m  Verify the Rover environment\r\n  \u001b[1mconfig\u001b[0m  Inspect or modify config\r\n  \u001b[1mhelp\u001b[0m    Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--config\u001b[0m <CONFIG>  Path to a TOML config file. If absent, defaults are used\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m             Print help\r\n  \u001b[1m-V\u001b["]
[4.119956, "o", "0m, \u001b[1m--version\u001b[0m          Print version\r\n"]
